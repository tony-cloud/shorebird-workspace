{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tony-cloud/shorebird-workspace/docs/schemas/release-record.v3.schema.json",
  "title": "Open Shorebird hardened-diversified release record, contract v3",
  "description": "What a hardened-diversified release stores as UpdateReleaseMetadata.security_record: release-record.v2 plus diversification_profile_id, the profile every build manifest of the release binds. All records merged for one release must agree. See docs/HARDENING_CONTRACTS.md sections 10.7 and 11.7.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "security_profile",
    "toolchain_id",
    "diversification_profile_id",
    "development_exceptions",
    "release_root_sha256",
    "root_version",
    "delegations_version",
    "delegations_sha256",
    "build_manifests"
  ],
  "properties": {
    "schema": {
      "const": "open-shorebird.release-record"
    },
    "contract_version": {
      "const": 3
    },
    "security_profile": {
      "const": "hardened-diversified"
    },
    "toolchain_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "diversification_profile_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "development_exceptions": {
      "type": "boolean"
    },
    "release_root_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "root_version": {
      "type": "integer",
      "minimum": 1
    },
    "delegations_version": {
      "type": "integer",
      "minimum": 1
    },
    "delegations_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_manifests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest_sha256",
          "signer_key_id",
          "config_sha256",
          "modules"
        ],
        "properties": {
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signer_key_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "arch",
                "measurement"
              ],
              "properties": {
                "platform": {
                  "enum": [
                    "android",
                    "ios",
                    "linux",
                    "macos",
                    "windows"
                  ]
                },
                "arch": {
                  "enum": [
                    "aarch64",
                    "arm",
                    "x86",
                    "x86_64"
                  ]
                },
                "measurement": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
