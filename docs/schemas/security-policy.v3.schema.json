{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tony-cloud/shorebird-workspace/docs/schemas/security-policy.v3.schema.json",
  "title": "Open Shorebird security policy, contract v3",
  "description": "The release security policy of a hardened-diversified native release (P5): security-policy.v2 with security_profile hardened-diversified and diversification_profile_id the sha256: id of the bytecode profile compiled into the engine (GN dart_bytecode_profile). Legacy and hardened policies stay v1/v2. Every hardened requirement applies. See docs/HARDENING_CONTRACTS.md sections 2, 10 and 11.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "security_profile",
    "signatures",
    "patch_verification",
    "patch_response_verification",
    "trust_roots",
    "update_origin_policy",
    "development_exceptions",
    "diversification_profile_id",
    "toolchain_id",
    "release_root"
  ],
  "properties": {
    "schema": {
      "const": "open-shorebird.security-policy"
    },
    "contract_version": {
      "const": 3
    },
    "security_profile": {
      "const": "hardened-diversified"
    },
    "signatures": {
      "const": "required"
    },
    "patch_verification": {
      "const": "strict"
    },
    "patch_response_verification": {
      "const": "required"
    },
    "trust_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "algorithm",
          "role"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "algorithm": {
            "enum": [
              "rsa-pkcs1-sha256"
            ]
          },
          "role": {
            "enum": [
              "patch-signing"
            ]
          }
        }
      },
      "minItems": 1
    },
    "update_origin_policy": {
      "const": "https-only"
    },
    "development_exceptions": {
      "type": "boolean"
    },
    "diversification_profile_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toolchain_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "release_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_sha256",
        "root_version",
        "threshold",
        "key_ids",
        "min_delegations_version"
      ],
      "properties": {
        "root_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "root_version": {
          "type": "integer",
          "minimum": 1
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        },
        "key_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "min_delegations_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
