package __JAVA_PACKAGE__;

import android.app.Activity;
import android.content.Intent;
import android.os.Bundle;
import android.os.Process;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.SecureRandom;
import java.util.*;
import java.util.concurrent.*;
import org.json.JSONObject;

/** Exported only in the uniquely named disposable, non-debuggable fixture. */
public final class ControlActivity extends Activity {
  private static final String CAPABILITY_DIGEST = "__CONTROL_SHA256__";
  private static final String PROCESS_TOKEN;
  private static final Set<String> NONCES = new HashSet<>();
  private static final ThreadPoolExecutor CONTROL = new ThreadPoolExecutor(1,1,0,TimeUnit.MILLISECONDS,
      new ArrayBlockingQueue<Runnable>(4),r->{Thread t=new Thread(r,"fixture-control");t.setDaemon(true);return t;},
      new ThreadPoolExecutor.AbortPolicy());
  private static volatile boolean configured, flutterAllowed;
  private static PatchKeyProvider provider;
  static { byte[] random=new byte[16]; new SecureRandom().nextBytes(random); PROCESS_TOKEN=PatchKeyProvider.hex(random); Arrays.fill(random,(byte)0); }

  static boolean mayStartFlutter() { return flutterAllowed; }
  private static native boolean nativeConfigure(PatchKeyProvider provider,byte[] receipt,byte[] observer,byte[] processToken);
  private static native byte[] nativeProbe(byte[] keyId,byte[] aad,byte[] challenge);

  @Override public void onCreate(Bundle state) {
    super.onCreate(null);
    Intent command=getIntent(); setIntent(new Intent());
    try {
      final Map<String,String> fields=parse(command);
      CONTROL.execute(()->execute(fields));
    } catch(Exception ignored) {
      // Invalid capabilities/observers receive no response. Queue failures also
      // release the Activity; accepted work keeps it foreground until complete.
      finish();
    }
  }
  @Override protected void onSaveInstanceState(Bundle state) { state.clear(); }

  private static Map<String,String> parse(Intent intent) throws Exception {
    Bundle extras=intent.getExtras(); if(extras==null||extras.size()>11) throw new IOException();
    Map<String,String> f=new HashMap<>();
    for(String name:extras.keySet()) { Object value=extras.get(name); if(!(value instanceof String)) throw new IOException(); PatchKeyProvider.utf8((String)value); f.put(name,(String)value); }
    String control=f.get("control");
    if(control==null||!control.matches("[0-9a-f]{64}")||!MessageDigest.isEqual(
        MessageDigest.getInstance("SHA-256").digest(control.getBytes(StandardCharsets.US_ASCII)),
        PatchKeyProvider.unhex(CAPABILITY_DIGEST))) throw new IOException();
    f.remove("control");
    if(!PatchKeyProvider.lowerHex(f.get("nonce"),48)) throw new IOException();
    PatchKeyProvider.endpoint(f.get("observer"),"native");
    synchronized(NONCES) { if(NONCES.size()>=1024||!NONCES.add(f.get("nonce"))) throw new IOException(); }
    return f;
  }
  private static void validate(Map<String,String> f) throws Exception {
    String operation=f.get("operation"); Set<String> allowed=new HashSet<>(Arrays.asList("operation","nonce","observer"));
    if("launch".equals(operation)||"probe".equals(operation)) {
      allowed.addAll(Arrays.asList("mode","receipt_url","provision_url","provision_token"));
      if(!Arrays.asList("correct","missing","wrong").contains(f.get("mode"))) throw new IOException();
      PatchKeyProvider.endpoint(f.get("receipt_url"),"receipt");
      if(f.containsKey("provision_url")!=f.containsKey("provision_token")) throw new IOException();
      if(f.containsKey("provision_url")) {
        PatchKeyProvider.endpoint(f.get("provision_url"),"key");
        if(!PatchKeyProvider.validToken(f.get("provision_token"))) throw new IOException();
      }
      if(operation.equals("probe")) {
        allowed.addAll(Arrays.asList("key_id","aad","challenge"));
        PatchKeyProvider.validateContext(f.get("key_id"),f.get("aad"));
        if(!PatchKeyProvider.lowerHex(f.get("challenge"),64)) throw new IOException();
      }
    } else if("inspect".equals(operation)) {
      allowed.addAll(Arrays.asList("key_id","aad"));
      if(f.containsKey("key_id")!=f.containsKey("aad")) throw new IOException();
      if(f.containsKey("key_id")) PatchKeyProvider.validateContext(f.get("key_id"),f.get("aad"));
    } else if(!"clear-provider".equals(operation)) throw new IOException();
    if(!allowed.containsAll(f.keySet())) throw new IOException();
  }
  private void execute(Map<String,String> f) {
    boolean finishAfterLaunch=false;
    try {
      validate(f); String operation=f.get("operation"); JSONObject result;
      if(operation.equals("inspect")) {
        PatchKeyProvider p=provider!=null?provider:new PatchKeyProvider(this,"correct",null,null);
        result=p.inspect(f.get("key_id"),f.get("aad"));
      } else if(operation.equals("clear-provider")) {
        if(configured) throw new IOException();
        configured=true; result=new PatchKeyProvider(this,"correct",null,null).clear();
      } else {
        if(configured) throw new IOException(); configured=true;
        provider=new PatchKeyProvider(this,f.get("mode"),f.get("provision_url"),f.get("provision_token"));
        // Loading libflutter does not construct a FlutterLoader/FlutterEngine.
        // The callback is registered before MainActivity can construct either.
        System.loadLibrary("flutter"); System.loadLibrary("shorebird_e2e_fixture");
        if(!nativeConfigure(provider,PatchKeyProvider.utf8(f.get("nonce")),
            PatchKeyProvider.utf8(f.get("receipt_url")),PatchKeyProvider.utf8(PROCESS_TOKEN))) throw new IOException();
        if(operation.equals("probe")) {
          byte[] challenge=PatchKeyProvider.unhex(f.get("challenge")); byte[] mac=null;
          try {
            mac=nativeProbe(PatchKeyProvider.utf8(f.get("key_id")),PatchKeyProvider.utf8(f.get("aad")),challenge);
            if(mac==null||mac.length!=32) throw new IOException();
            result=new JSONObject().put("mac_hex",PatchKeyProvider.hex(mac)).put("native_thread_attached",true);
          } finally { Arrays.fill(challenge,(byte)0); if(mac!=null) Arrays.fill(mac,(byte)0); }
        } else {
          report(f,"ready",new JSONObject().put("provider_registered",true));
          flutterAllowed=true;
          runOnUiThread(()->{
            try { startActivity(new Intent(this,MainActivity.class)); }
            catch(RuntimeException ignored) { /* Missing receipt fails the host scenario. */ }
            finally { finish(); }
          });
          finishAfterLaunch=true;
          return;
        }
      }
      report(f,operation,result);
    } catch(Throwable ignored) {
      try { report(f,"error",new JSONObject().put("reason","operation-failed")); } catch(Exception unavailable) { /* No logs or external fallback. */ }
    } finally {
      f.clear();
      if(!finishAfterLaunch) runOnUiThread(this::finish);
    }
  }
  private static void report(Map<String,String> f,String operation,JSONObject payload) throws Exception {
    JSONObject report=new JSONObject().put("schema","android-native-control-v1").put("nonce",f.get("nonce"))
        .put("pid",Process.myPid()).put("process_token",PROCESS_TOKEN).put("operation",operation).put("payload",payload);
    byte[] body=report.toString().getBytes(StandardCharsets.UTF_8);
    if(body.length>2*1024*1024) throw new IOException();
    try { PatchKeyProvider.post(f.get("observer"),"native",body,null,1024,true); } finally { Arrays.fill(body,(byte)0); }
  }
}
