import 'dart:async';
import 'package:flutter/material.dart';
import 'package:flutter/rendering.dart';
import 'ffi_plugin.dart';
import 'ffi_status.dart';
import 'license.dart';
import 'removed_library.dart';
import 'unchanged_caller.dart';

final statusKey = GlobalKey();
const expectedText =
    'license:free full-replacement:verified value:10 full-ffi:v1-base';

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final evidence = await runFfiChecks();
  final firstFrame = Completer<void>();
  runApp(const LicenseFlavorPatchApp());
  WidgetsBinding.instance.addPostFrameCallback((_) => firstFrame.complete());
  await firstFrame.future;
  final rendered = statusKey.currentContext?.findRenderObject();
  if (rendered is! RenderParagraph ||
      !rendered.attached ||
      !rendered.hasSize ||
      rendered.size.isEmpty ||
      rendered.text.toPlainText() != expectedText) {
    throw StateError('Full replacement baseline rendered assertion failed');
  }
  writeFullFfiStatus(
    phase: 'base',
    license: state.name,
    proFeatureEnabled: state.isPro,
    renderedText: expectedText,
    evidence: evidence,
  );
}

class LicenseFlavorPatchApp extends StatelessWidget {
  const LicenseFlavorPatchApp({super.key});

  @override
  Widget build(BuildContext context) {
    if (state.name != 'free' ||
        state.isPro ||
        state.retained != 7 ||
        retainedByUnchangedCaller() != 7 ||
        !canonicalNestedConstant() ||
        state.removedField != 'retired-field' ||
        state.removedMethod() != 'retired-method' ||
        (const RemovedLicense()).value != 'retired-class' ||
        retiredLibraryValue() != 'retired-library' ||
        state.score(3) != 10 ||
        LicenseState.factor != 1 ||
        LicenseState.staticLabel != 'free-static' ||
        LicenseState.describe(7) != 'free:7') {
      throw StateError('Full replacement baseline semantic assertion failed');
    }
    return MaterialApp(
      home: Scaffold(
        body: Center(child: Text(expectedText, key: statusKey)),
      ),
    );
  }
}
