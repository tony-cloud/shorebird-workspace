import UIKit
import Darwin
import Flutter
import Security

__CACHE_CONTROLS__

__DIAGNOSTICS__

// Disposable independently authenticated provisioning control. Keys arrive only
// in a private child environment, never assets, output, receipts or Dart code.
enum IosVariantFixture {
  static let service = "__SERVICE__"
  static let bundleID = "__BUNDLE_ID__"
  static let session = "__SESSION__"
  static let appID = "__APP_ID__"
  static let release = "__RELEASE__"
  static let allowed = ["pro": "__PRO_KEY_ID__", "enterprise": "__ENTERPRISE_KEY_ID__"]
  static var bootTime: Double = 0
  static var cacheBefore: [String: Any] = [:]
  static var cacheAfterControl: [String: Any] = [:]
  static var cacheControl: [String: Any]?
  static var cleanupReceipt: [String: Any]?
  static var cleanupOnly: Bool { cleanupReceipt != nil }
  static var cacheRoot: URL {
    URL(fileURLWithPath: NSHomeDirectory(), isDirectory: true).resolvingSymlinksInPath()
      .appendingPathComponent("Library/Application Support/shorebird/shorebird_updater", isDirectory: true)
  }
  static var evidenceDirectory: URL {
    URL(fileURLWithPath: NSHomeDirectory(), isDirectory: true)
      .appendingPathComponent("Library/Application Support/shorebird-ios-variant-fixture", isDirectory: true)
  }
  static func query(_ account: String) -> [String: Any] {
    [kSecClass as String: kSecClassGenericPassword,
     kSecAttrService as String: service, kSecAttrAccount as String: account]
  }
  static func evidence(_ value: [String: Any], name: String) {
    do {
      try FileManager.default.createDirectory(at: evidenceDirectory, withIntermediateDirectories: true)
      try JSONSerialization.data(withJSONObject: value, options: [.sortedKeys])
        .write(to: evidenceDirectory.appendingPathComponent(name), options: [.atomic])
    } catch { preconditionFailure("Could not write native fixture receipt") }
  }
  static func read(_ keyID: String, _ context: Data) -> Data? {
    guard let root = try? JSONSerialization.jsonObject(with: context) as? [String: Any],
          root["version"] as? Int == 2,
          let digest = root["selection_digest"] as? String,
          digest.range(of: "^[a-f0-9]{64}$", options: .regularExpression) != nil,
          let descriptor = root["selection"] as? [String: Any],
          let scope = descriptor["scope"] as? [String: Any],
          scope["app_id"] as? String == appID,
          scope["release_version"] as? String == release,
          scope["platform"] as? String == "ios",
          scope["arch"] as? String == "aarch64",
          scope["runtime_profile"] as? String == "interpreter-full",
          let baseHash = scope["base_artifact_hash"] as? String,
          baseHash.range(of: "^[a-f0-9]{64}$", options: .regularExpression) != nil,
          let abiHash = scope["host_abi_hash"] as? String,
          abiHash.range(of: "^[a-f0-9]{64}$", options: .regularExpression) != nil,
          let clientHash = scope["client_id_hash"] as? String,
          clientHash.range(of: "^[a-f0-9]{64}$", options: .regularExpression) != nil,
          let revision = descriptor["entitlement_revision"] as? String,
          revision.hasPrefix(session + ":"),
          let variant = descriptor["variant_id"] as? String,
          descriptor["license_type"] as? String == variant,
          allowed[variant] == keyID,
          descriptor["channel"] as? String == "stable",
          let target = descriptor["target"] as? [String: Any],
          target["kind"] as? String == "patch",
          let artifactHash = target["artifact_hash"] as? String,
          artifactHash.range(of: "^[a-f0-9]{64}$", options: .regularExpression) != nil,
          target["encryption"] as? String == "artifact-aes-256-gcm",
          target["artifact_key_id"] as? String == keyID else { return nil }
    var request = query(keyID)
    request[kSecReturnData as String] = true
    request[kSecMatchLimit as String] = kSecMatchLimitOne
    var value: CFTypeRef?
    guard SecItemCopyMatching(request as CFDictionary, &value) == errSecSuccess,
          let data = value as? Data, data.count == 32 else { return nil }
    evidence(["schema": "ios-variant-provider-v2", "session": session,
              "nonce": ProcessInfo.processInfo.environment["OPEN_SHOREBIRD_TEST_NONCE"] ?? "",
              "variant": variant, "account": keyID, "selection_digest": digest,
              "epoch": descriptor["epoch"] ?? NSNull(),
              "pid": ProcessInfo.processInfo.processIdentifier,
              "time": Date().timeIntervalSince1970], name: "provider.json")
    return data
  }
  static func beforeEngine() {
    precondition(Bundle.main.bundleIdentifier == bundleID, "Wrong disposable bundle")
    let env = ProcessInfo.processInfo.environment
    bootTime = Date().timeIntervalSince1970
    // Failure cleanup cannot depend on a valid cache, a Flutter engine, Dart,
    // or a successful adversarial boot. It never replays the failed control.
    if env["OPEN_SHOREBIRD_TEST_CLEANUP_KEYS_ONLY"] == "1" || env["OPEN_SHOREBIRD_TEST_CLEANUP_RECEIPT_ONLY"] == "1" {
      precondition(env["OPEN_SHOREBIRD_TEST_KEY_ACTION"] == nil && env["OPEN_SHOREBIRD_TEST_CACHE_ACTION"] == nil)
      let nonce = env["OPEN_SHOREBIRD_TEST_NONCE"] ?? ""
      precondition(nonce.range(of: "^[a-f0-9]{48}$", options: .regularExpression) != nil)
      if env["OPEN_SHOREBIRD_TEST_CLEANUP_RECEIPT_ONLY"] == "1" {
        let url = evidenceDirectory.appendingPathComponent("native-cleanup.json")
        guard let data = try? Data(contentsOf: url), data.count < 16384,
              let saved = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
              saved["schema"] as? String == "ios-variant-native-cleanup-v1", saved["nonce"] as? String == nonce,
              saved["session"] as? String == session, saved["bundle_id"] as? String == bundleID,
              saved["service"] as? String == service else { preconditionFailure("Original native cleanup receipt unavailable") }
        cleanupReceipt = saved
      } else {
        var keys: [String: Any] = [:]
        for variant in allowed.keys.sorted() {
          let account = allowed[variant]!
          let removed = SecItemDelete(query(account) as CFDictionary)
          precondition(removed == errSecSuccess || removed == errSecItemNotFound)
          keys[variant] = ["account": account, "result": removed == errSecSuccess ? "deleted" : "absent"]
        }
        let receipt: [String: Any] = ["schema": "ios-variant-native-cleanup-v1", "session": session, "nonce": nonce,
          "bundle_id": bundleID, "service": service, "pid": ProcessInfo.processInfo.processIdentifier,
          "time": Date().timeIntervalSince1970, "mode": "native-keychain-cleanup-only", "keys": keys]
        evidence(receipt, name: "native-cleanup.json")
        cleanupReceipt = receipt
      }
      return
    }
    do {
      cacheBefore = try IosVariantCache.snapshot(cacheRoot)
      if let action = env["OPEN_SHOREBIRD_TEST_CACHE_ACTION"] {
        precondition(env["OPEN_SHOREBIRD_TEST_KEY_ACTION"] == nil, "One native control per launch")
        var receipt: [String: Any] = ["schema": "ios-variant-cache-control-v1", "session": session,
          "bundle_id": bundleID, "nonce": env["OPEN_SHOREBIRD_TEST_NONCE"] ?? "", "action": action,
          "pid": ProcessInfo.processInfo.processIdentifier, "time": bootTime]
        if action == "inspect" { receipt["result"] = "inspected" }
        else {
          let changed = try IosVariantCache.tamper(cacheRoot, action: action,
              number: env["OPEN_SHOREBIRD_TEST_CACHE_PATCH"] ?? "",
              expected: env["OPEN_SHOREBIRD_TEST_CACHE_SHA256"] ?? "")
          receipt.merge(changed) { _, next in next }
        }
        cacheControl = receipt
      }
      cacheAfterControl = try IosVariantCache.snapshot(cacheRoot)
    } catch {
      // Preserve failure as missing acceptance, never expose filesystem errors,
      // encrypted bytes or authentication contents in a diagnostic receipt.
      preconditionFailure("Native cache control/snapshot failed")
    }
    if let action = env["OPEN_SHOREBIRD_TEST_KEY_ACTION"] {
      guard let account = env["OPEN_SHOREBIRD_TEST_KEY_ID"], allowed.values.contains(account) else {
        preconditionFailure("Refusing foreign Keychain account")
      }
      var result = ""
      switch action {
      case "provision", "overwrite":
        guard let hex = env["OPEN_SHOREBIRD_TEST_KEY_HEX"],
              hex.range(of: "^[a-f0-9]{64}$", options: .regularExpression) != nil else {
          preconditionFailure("Invalid private provisioning")
        }
        var bytes = [UInt8]()
        var index = hex.startIndex
        while index < hex.endIndex {
          let end = hex.index(index, offsetBy: 2)
          bytes.append(UInt8(hex[index..<end], radix: 16)!)
          index = end
        }
        let removed = SecItemDelete(query(account) as CFDictionary)
        precondition(removed == errSecSuccess || removed == errSecItemNotFound)
        var item = query(account)
        item[kSecValueData as String] = Data(bytes)
        item[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
        precondition(SecItemAdd(item as CFDictionary, nil) == errSecSuccess)
        _ = bytes.withUnsafeMutableBytes { $0.initializeMemory(as: UInt8.self, repeating: 0) }
        result = "stored"
      case "delete":
        let removed = SecItemDelete(query(account) as CFDictionary)
        precondition(removed == errSecSuccess || removed == errSecItemNotFound)
        result = removed == errSecSuccess ? "deleted" : "absent"
      default: preconditionFailure("Unsupported private key action")
      }
      evidence(["schema": "ios-variant-key-control-v2", "nonce": env["OPEN_SHOREBIRD_TEST_NONCE"] ?? "", "action": action,
                "result": result, "bundle_id": bundleID, "service": service,
                "session": session, "account": account,
                "time": Date().timeIntervalSince1970,
                "pid": ProcessInfo.processInfo.processIdentifier], name: "key-control.json")
      // Continue app startup after deletion. The nonce-bound
      // Dart report transports this native receipt even when distribution app
      // containers cannot be downloaded. No debugger or network provisioning.
    }
    iosVariantDiagnosticStage(0, 0)
    precondition(IosFullFfiRetain() == 13, "Released native exports missing")
    precondition(FlutterDartProject.setShorebirdAotPatchKeyProviderV2 { read($0, $1) },
                 "V2 provider must precede first engine")
    evidence(["schema": "ios-variant-container-v2", "bundle_id": bundleID,
              "home": NSHomeDirectory(), "temp": NSTemporaryDirectory(),
              "status_path": evidenceDirectory.appendingPathComponent("ffi-status.json").path,
              "time": Date().timeIntervalSince1970,
              "pid": ProcessInfo.processInfo.processIdentifier], name: "container.json")
  }
  static func postCleanupReceipt() {
    guard let receipt = cleanupReceipt,
          let body = try? JSONSerialization.data(withJSONObject: receipt, options: [.sortedKeys]),
          let endpoint = ProcessInfo.processInfo.environment["OPEN_SHOREBIRD_TEST_OBSERVER"],
          let url = URL(string: endpoint) else { return }
    var request = URLRequest(url: url, timeoutInterval: 5)
    request.httpMethod = "POST"
    request.setValue("application/json", forHTTPHeaderField: "Content-Type")
    request.httpBody = body
    URLSession.shared.dataTask(with: request) { _, response, _ in
      if (response as? HTTPURLResponse)?.statusCode == 204 { DispatchQueue.main.async { exit(0) } }
    }.resume()
  }
}


// Integer-only @Native markers avoid the malloc/lookupFunction path under
// investigation. The linker explicitly retains this export in the copied app.
@_cdecl("IosVariantDiagnosticStage")
public func iosVariantDiagnosticStage(_ stage: Int64, _ value: Int64) {
  guard !IosVariantFixture.cleanupOnly else { return }
  let env = ProcessInfo.processInfo.environment
  _ = IosVariantDiagnostics.record(root: IosVariantFixture.evidenceDirectory, context: [
    "session": IosVariantFixture.session, "pid": Int(ProcessInfo.processInfo.processIdentifier),
    "nonce": env["OPEN_SHOREBIRD_TEST_NONCE"] as Any? ?? NSNull(),
    "home_present": env["HOME"] != nil,
    "status_route": env["OPEN_SHOREBIRD_TEST_STATUS_ROUTE"] as Any? ?? NSNull(),
    "report_route": env["OPEN_SHOREBIRD_TEST_REPORT_ROUTE"] as Any? ?? NSNull()], stage: stage, value: value)
}

@_cdecl("IosVariantSubmitReport")
public func iosVariantSubmitReport(_ pointer: UnsafePointer<CChar>?) {
  iosVariantDiagnosticStage(23, 0)
  guard let pointer = pointer,
        let body = String(validatingUTF8: pointer)?.data(using: .utf8),
        body.count <= 65536,
        var value = try? JSONSerialization.jsonObject(with: body) as? [String: Any],
        value["schema"] as? String == "ios-variant-e2e-v2",
        value["session"] as? String == IosVariantFixture.session,
        let nonce = ProcessInfo.processInfo.environment["OPEN_SHOREBIRD_TEST_NONCE"],
        value["nonce"] as? String == nonce else { return }
  do {
    value["native_boot"] = ["session": IosVariantFixture.session, "nonce": nonce,
      "pid": ProcessInfo.processInfo.processIdentifier, "time": IosVariantFixture.bootTime]
    value["cache_before"] = IosVariantFixture.cacheBefore
    value["cache_after_control"] = IosVariantFixture.cacheAfterControl
    value["cache_after"] = try IosVariantCache.snapshot(IosVariantFixture.cacheRoot)
    value["cache_control"] = IosVariantFixture.cacheControl as Any? ?? NSNull()
    let final = try JSONSerialization.data(withJSONObject: value, options: [.sortedKeys])
    guard final.count <= 65536 else { return }
    try final.write(to: IosVariantFixture.evidenceDirectory.appendingPathComponent("variant-status.json"), options: [.atomic])
    iosVariantDiagnosticStage(24, 0)
    guard value["report_route"] as? String == "native",
          let endpoint = ProcessInfo.processInfo.environment["OPEN_SHOREBIRD_TEST_OBSERVER"],
          let url = URL(string: endpoint) else { return }
  var request = URLRequest(url: url, timeoutInterval: 5)
  request.httpMethod = "POST"
  request.setValue("application/json", forHTTPHeaderField: "Content-Type")
  request.httpBody = final
  // Never wait on a semaphore on the Flutter/UI thread. The device's local
  // network permission prompt must remain serviceable while updates run.
  iosVariantDiagnosticStage(25, 0)
  URLSession.shared.dataTask(with: request) { _, _, _ in }.resume()
  } catch { preconditionFailure("Native cache observation failed") }
}

// UIKit is the actual entry delegate. Constructing FlutterAppDelegate itself
// touches Flutter callback caches, so composition must occur only after the
// native-only cleanup branch has returned. No lazy Flutter delegate accessors.
@main
@objc class AppDelegate: UIResponder, UIApplicationDelegate, FlutterImplicitEngineDelegate, FlutterAppLifeCycleProvider {
  private var flutterDelegate: FlutterAppDelegate?
  override init() {
    super.init()
    IosVariantFixture.beforeEngine()
    if !IosVariantFixture.cleanupOnly { flutterDelegate = FlutterAppDelegate() }
  }
  func application(_ application: UIApplication,
      willFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {
    guard let delegate = flutterDelegate else { return true }
    return delegate.application(application, willFinishLaunchingWithOptions: launchOptions)
  }
  func application(_ application: UIApplication,
      didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {
    guard let delegate = flutterDelegate else {
      IosVariantFixture.postCleanupReceipt()
      return true
    }
    return delegate.application(application, didFinishLaunchingWithOptions: launchOptions)
  }
  func application(_ application: UIApplication, configurationForConnecting session: UISceneSession,
      options: UIScene.ConnectionOptions) -> UISceneConfiguration {
    // Every saved and new session has this same UIKit-only bootstrap. The
    // prepared Info.plist also has no automatic Main storyboard entry.
    let configuration = UISceneConfiguration(name: "fixture-bootstrap", sessionRole: session.role)
    configuration.delegateClass = IosVariantSceneDelegate.self
    configuration.storyboard = nil
    return configuration
  }
  func didInitializeImplicitFlutterEngine(_ engineBridge: FlutterImplicitEngineBridge) {
    precondition(!IosVariantFixture.cleanupOnly)
    GeneratedPluginRegistrant.register(with: engineBridge.pluginRegistry)
  }
  func add(_ delegate: FlutterApplicationLifeCycleDelegate & NSObjectProtocol) {
    flutterDelegate?.add(delegate)
  }
  override func responds(to selector: Selector!) -> Bool {
    super.responds(to: selector) || (flutterDelegate?.responds(to: selector) ?? false)
  }
  override func forwardingTarget(for selector: Selector!) -> Any? {
    if let delegate = flutterDelegate, delegate.responds(to: selector) { return delegate }
    return super.forwardingTarget(for: selector)
  }
}

// UIKit creates this class for restored sessions too. It cannot inherit from
// FlutterSceneDelegate or auto-load Main: both decisions occur after the guard.
@objc class IosVariantSceneDelegate: UIResponder, UIWindowSceneDelegate {
  var window: UIWindow?
  private var flutterScene: FlutterSceneDelegate?
  func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options: UIScene.ConnectionOptions) {
    guard let scene = scene as? UIWindowScene else { return }
    let owned = UIWindow(windowScene: scene)
    window = owned
    if IosVariantFixture.cleanupOnly {
      owned.rootViewController = UIViewController()
      owned.makeKeyAndVisible()
      return
    }
    let delegate = FlutterSceneDelegate()
    flutterScene = delegate
    delegate.window = owned
    owned.rootViewController = UIStoryboard(name: "Main", bundle: nil).instantiateInitialViewController()
    delegate.scene(scene, willConnectTo: session, options: options)
    owned.makeKeyAndVisible()
  }
  override func responds(to selector: Selector!) -> Bool {
    super.responds(to: selector) || (flutterScene?.responds(to: selector) ?? false)
  }
  override func forwardingTarget(for selector: Selector!) -> Any? {
    if let delegate = flutterScene, delegate.responds(to: selector) { return delegate }
    return super.forwardingTarget(for: selector)
  }
}
